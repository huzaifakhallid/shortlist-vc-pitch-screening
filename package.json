{
  "name": "shortlist",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "typecheck": "tsc && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @shortlist/db generate",
    "db:migrate": "pnpm --filter @shortlist/db migrate",
    "db:seed": "pnpm --filter @shortlist/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
