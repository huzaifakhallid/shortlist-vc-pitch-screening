# Shortlist environment variables.
# Copy to .env and fill in. Every variable is validated at startup by packages/schemas/env.ts;
# a missing or invalid value stops the process with the variable's name.
# Local development values only. Real deployments set these in Railway.
# Variables are added here when a milestone starts using them.

# PostgreSQL 16 connection string (web + worker). Local dev DB, localhost only, synthetic data.
DATABASE_URL=postgres://shortlist:shortlist@localhost:5432/shortlist

# Separate database used by packages/db tests. Wiped by the tests.
TEST_DATABASE_URL=postgres://shortlist:shortlist@localhost:5432/shortlist_test

# Auth.js secret (web). At least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public base URL of the web app (web), used in magic links.
APP_URL=http://localhost:3000

# Google Gemini API key (worker). Only synthetic data ever goes through a free-tier key:
# Google may use free-tier inputs to improve its products (design §14.4, §15.4).
# Client deployments always use a paid key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-a-gemini-api-key

# Model requests per minute for ONE worker process (worker); two workers on one key
# make twice the calls, so split the key's limit between them. The rate limiter in
# packages/agents/shared/llm.ts spaces calls to stay under it. Set it to your key's
# per-model RPM limit (lower on the free tier).
LLM_RPM=10

# Tier of GEMINI_API_KEY (worker): "free" or "paid". Required, no default. On "free" the
# worker refuses runs for any workspace not marked synthetic, because Google may use
# free-tier inputs to improve its products (design §14.4, §15.4). Client deployments: "paid".
GEMINI_KEY_TIER=free

# One-click sign-in as the seeded Kestrel demo personas (web): "true" or "false".
# Only for local development and the public demo; never "true" for a client.
DEMO_LOGINS=true
